# Google Analytics 4 - Add your Measurement ID to enable tracking
# Get it from: https://analytics.google.com/ → Admin → Data Streams → Your stream
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: ISO date YYYY-MM-DD — sets homepage Article/WebPage dateModified in JSON-LD at build time (Vercel: add as env var per deploy)
# NEXT_PUBLIC_SITE_LAST_MODIFIED=2026-03-21
